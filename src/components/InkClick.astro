---
// 全站点击墨点：固定在最上层，但不拦截鼠标事件。
---

<canvas id="ink-canvas" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById('ink-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    // 适配屏幕尺寸与像素密度
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resize);
    resize();

    // 墨点参数（匹配水墨山河风格）
    const INK_COLOR = 'rgba(30, 30, 30, 0.7)'; // 低饱和深灰，非纯黑
    const MIN_RADIUS = 8;
    const MAX_RADIUS = 25;
    const FADE_SPEED = 0.015; // 淡出速度，模拟墨迹晕染消散

    const particles = [];

    class InkParticle {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.radius = Math.random() * (MAX_RADIUS - MIN_RADIUS) + MIN_RADIUS;
        this.opacity = 0.7;
        // 模拟飞白：随机添加2-4个微小溅射点
        this.splatters = Array.from({ length: Math.floor(Math.random() * 3) + 2 }, () => ({
          dx: (Math.random() - 0.5) * 30,
          dy: (Math.random() - 0.5) * 30,
          r: Math.random() * 3 + 1,
        }));
      }

      update() {
        this.opacity -= FADE_SPEED;
        return this.opacity > 0;
      }

      draw() {
        ctx.save();
        ctx.globalAlpha = this.opacity;
        ctx.fillStyle = INK_COLOR;

        // 主墨点
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();

        // 飞白溅射点
        this.splatters.forEach((s) => {
          ctx.beginPath();
          ctx.arc(this.x + s.dx, this.y + s.dy, s.r, 0, Math.PI * 2);
          ctx.fill();
        });

        ctx.restore();
      }
    }

    // 点击事件绑定
    document.addEventListener(
      'click',
      (e) => {
        particles.push(new InkParticle(e.clientX, e.clientY));
      },
      { passive: true }
    );

    // 动画循环
    function animate() {
      ctx.clearRect(0, 0, width, height);
      for (let i = particles.length - 1; i >= 0; i--) {
        if (!particles[i].update()) {
          particles.splice(i, 1);
        } else {
          particles[i].draw();
        }
      }
      requestAnimationFrame(animate);
    }
    animate();
  })();
</script>

<style>
  #ink-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>
