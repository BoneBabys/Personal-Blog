---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';
import InkClick from '../../components/InkClick.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.section === 'skills');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const dateFormat = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const siteName = '胡炳坤的个人博客';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description} />
    <meta name="theme-color" content="#f6f4ee" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
    <title>{post.data.title} · 专业技能 · {siteName}</title>
  </head>
  <body class="skills-page skills-article-page">
    <main class="page-shell article-shell skills-shell">
      <header class="site-header">
        <a class="wordmark" href="/">{siteName}<span>。</span></a>
        <nav aria-label="Main navigation">
          <a href="/travel/">旅行见闻</a>
          <a class="active" href="/skills/">专业技能</a>
        </nav>
      </header>

      <div class="skills-article-layout">
        <aside class="toc" aria-label="文章目录">
          <p>本页目录</p>
          <ol>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          <a class="toc-back" href="/skills/">← 全部技能文章</a>
        </aside>

        <article class="article skill-article">
          <p class="skills-label">SKILL SHARING · <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time></p>
          <h1>{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
          <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
          <div class="article-content"><Content /></div>
          <Comments />
        </article>
      </div>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {siteName}</span>
      </footer>
    </main>
    <InkClick />
  </body>
</html>
