---
import '../styles/global.css';
import InkClick from '../components/InkClick.astro';

const siteName = '胡炳坤的个人博客';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="胡炳坤的个人博客：旅行见闻与专业技能，山水行旅与技术手记。" />
    <meta name="theme-color" content="#f3eee2" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
    <title>{siteName}</title>
  </head>
  <body class="home-page">
    <main class="home-stage">
      <section class="home-card" aria-labelledby="home-title">
        <span class="home-seal" aria-hidden="true">胡</span>

        <div class="home-card-inner">
          <header class="home-head">
            <p class="home-eyebrow">INK · MOUNTAINS · WORDS</p>
            <h1 id="home-title">胡炳坤的个人博客</h1>
            <p class="home-sub">山水行旅　·　技术手记</p>
          </header>

          <nav class="home-entries" aria-label="博客栏目">
            <a class="home-entry" href="/travel/">
              <span class="home-entry-no" aria-hidden="true">壹</span>
              <span class="home-entry-title">旅行见闻</span>
              <span class="home-entry-en">TRAVEL NOTES</span>
              <span class="home-entry-desc">山水、城市与人间烟火</span>
              <span class="home-entry-arrow" aria-hidden="true">→</span>
            </a>
            <a class="home-entry" href="/skills/">
              <span class="home-entry-no" aria-hidden="true">贰</span>
              <span class="home-entry-title">专业技能</span>
              <span class="home-entry-en">SKILLS &amp; NOTES</span>
              <span class="home-entry-desc">代码、项目与实践复盘</span>
              <span class="home-entry-arrow" aria-hidden="true">→</span>
            </a>
          </nav>

          <p class="home-foot">择一入卷　·　墨迹随行</p>
        </div>
      </section>
    </main>

    <InkClick />
  </body>
</html>
