---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const siteName = '我在中国的记忆';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="记录我在中国所见的山、水、人和味道。" />
    <title>{siteName} · 山海之间</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="/">{siteName}<span>。</span></a>
        <nav aria-label="主导航">
          <a href="#about">关于</a>
          <a href="mailto:hello@example.com">联系</a>
        </nav>
      </header>

      <section class="intro" id="about">
        <p class="eyebrow">我在中国的日记</p>
        <h1>我在中国看见的，<br /><span>是一段山水与人情的故事。</span></h1>
        <p class="intro-copy">这里记录我在中国走过的山路、夜市和日出——那些不急着被定义的日常，以及被风景慢慢放大的幸福。</p>
        <span class="intro-seal" aria-hidden="true">记<br />忆</span>
      </section>

      <section class="posts-section" aria-labelledby="posts-heading">
        <div class="section-heading">
          <h2 id="posts-heading">最近的文字</h2>
          <span>共 {posts.length} 篇</span>
        </div>
        <div class="post-list">
          {posts.map((post) => (
            <article class="post-card">
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.tags.length > 0 && <span class="tag">{post.data.tags[0]}</span>}
              </div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title} <span aria-hidden="true">↗</span></a></h3>
              <p>{post.data.description}</p>
            </article>
          ))}
          {posts.length === 0 && <p class="empty-state">新的旅途记录正在路上，敬请期待。</p>}
        </div>
      </section>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {siteName}</span>
        <a href="https://github.com/">GitHub ↗</a>
      </footer>
    </main>
  </body>
</html>
